# Web3Forms access key (free at https://web3forms.com). Safe to expose publicly.
PUBLIC_WEB3FORMS_KEY=

# PostHog analytics (optional). Project API key from PostHog → Project settings.
PUBLIC_POSTHOG_KEY=
# https://eu.i.posthog.com or https://us.i.posthog.com
PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

---
/** Standalone Contact page: /contact/ and /en/contact/ (design: "Contact" boards 1i/1j). */
import BaseLayout from '../layouts/BaseLayout.astro';
import Contact from '../components/sections/Contact.astro';
import { useT, type Lang } from '../i18n';
import { pages } from '../i18n/routes';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const { t } = useT(lang);
---

<BaseLayout lang={lang} title={t('meta.contactTitle')} description={t('meta.contactDescription')} alternates={pages.contact}>
  <Contact lang={lang} headingLevel="h1" />
</BaseLayout>

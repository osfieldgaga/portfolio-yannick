---
/**
 * Bilingual 404 (Cloudflare serves one 404.html for every missing URL).
 * French first (default locale), English below.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { useT } from '../i18n';
import { pages } from '../i18n/routes';

const fr = useT('fr').t;
const en = useT('en').t;
---

<BaseLayout lang="fr" title={`${fr('meta.notFoundTitle')} · ${en('meta.notFoundTitle')}`} description={fr('meta.notFoundDescription')} alternates={pages.home} noindex>
  <section class="nf" aria-labelledby="nf-title">
    <div class="rule" aria-hidden="true"></div>
    <div class="kicker">
      <span class="slashes" aria-hidden="true">///</span>
      <span>{fr('notFound.kicker')}</span>
      <span lang="en">· {en('notFound.kicker')}</span>
    </div>
    <p class="code" aria-hidden="true">404</p>
    <h1 id="nf-title">
      <span>{fr('notFound.title')}</span>
      <span lang="en" class="en">{en('notFound.title')}</span>
    </h1>
    <div class="cols">
      <div class="col">
        <p>{fr('notFound.body')}</p>
        <a class="btn btn-primary" href={pages.home.fr} hreflang="fr">{fr('notFound.home')}<Icon name="arrow-right" /></a>
      </div>
      <div class="col" lang="en">
        <p>{en('notFound.body')}</p>
        <a class="btn btn-secondary" href={pages.home.en} hreflang="en">{en('notFound.home')}<Icon name="arrow-right" /></a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    max-width: var(--max-w);
    margin: 0 auto;
    padding: clamp(48px, 7vw, 96px) var(--pad-x) clamp(72px, 9vw, 128px);
  }
  .rule {
    margin-bottom: 20px;
  }
  .code {
    margin: clamp(16px, 3vw, 32px) 0 0;
    font-weight: 800;
    font-stretch: 125%;
    font-size: clamp(96px, 22vw, 320px);
    line-height: 0.82;
    letter-spacing: -0.04em;
    color: transparent;
    -webkit-text-stroke: 2px var(--red);
  }
  h1 {
    margin-top: clamp(16px, 3vw, 32px);
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-weight: 800;
    font-stretch: 118%;
    font-size: clamp(30px, 4.4vw, 56px);
    line-height: 1;
    letter-spacing: -0.025em;
  }
  h1 .en {
    color: var(--muted);
  }
  .cols {
    margin-top: clamp(32px, 5vw, 56px);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
    gap: 32px clamp(32px, 5vw, 72px);
    border-top: 1px solid var(--line);
    padding-top: 24px;
  }
  .col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
  }
  .col p {
    font-size: 18px;
  }
</style>

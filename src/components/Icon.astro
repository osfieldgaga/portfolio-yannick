---
/** Lucide-style stroke icons used in the design. Always decorative (aria-hidden). */
const icons = {
  'arrow-right': { d: 'M5 12h14M12 5l7 7-7 7', w: 2 },
  'arrow-left': { d: 'M19 12H5M12 19l-7-7 7-7', w: 2 },
  'arrow-down': { d: 'M12 5v14M19 12l-7 7-7-7', w: 2 },
  'arrow-up': { d: 'M12 19V5M5 12l7-7 7 7', w: 2 },
  'arrow-up-right': { d: 'M7 7h10v10M7 17 17 7', w: 2 },
  'chevron-left': { d: 'm15 18-6-6 6-6', w: 1.75 },
  'chevron-right': { d: 'm9 18 6-6-6-6', w: 1.75 },
  close: { d: 'M18 6 6 18M6 6l12 12', w: 1.75 },
  menu: { d: 'M4 6h16M4 12h16M4 18h16', w: 1.75 },
  moon: { d: 'M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z', w: 1.75 },
  sun: { d: 'M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41M16 12a4 4 0 1 1-8 0 4 4 0 0 1 8 0Z', w: 1.75 },
  whatsapp: { d: 'M7.9 20A9 9 0 1 0 4 16.1L2 22Z', w: 2 },
  download: { d: 'M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3', w: 2 },
  alert: { d: 'M12 8v4M12 16h.01M22 12a10 10 0 1 1-20 0 10 10 0 0 1 20 0Z', w: 2 },
} as const;

export type IconName = keyof typeof icons;

interface Props {
  name: IconName;
  size?: number;
  class?: string;
  /** Overrides the stroke colour (default: currentColor). */
  stroke?: string;
}

const { name, size = 16, class: className, stroke } = Astro.props;
const icon = icons[name];
---

<svg
  aria-hidden="true"
  focusable="false"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  class={className}
  fill="none"
  stroke={stroke ?? 'currentColor'}
  stroke-width={icon.w}
  stroke-linecap="round"
  stroke-linejoin="round"><path d={icon.d}></path></svg>

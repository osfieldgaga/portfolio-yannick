---
/**
 * All <head> metadata for a page: title, description, canonical, hreflang,
 * Open Graph / Twitter and optional JSON-LD. Used by BaseLayout on every page.
 */
import { site } from '../site.config';
import { useT, otherLang, type Lang } from '../i18n';
import type { Alternates } from '../i18n/routes';

interface Props {
  lang: Lang;
  /** Page title without the site suffix. Omit on the homepage to use meta.siteTitle. */
  title?: string;
  description: string;
  /** Absolute or root-relative URL of a 1200×630 image. Defaults to site.ogImage. */
  image?: string;
  /** Pixel size of `image` (defaults to 1200×630, the size of the default image). */
  imageWidth?: number;
  imageHeight?: number;
  imageAlt?: string;
  type?: 'website' | 'article' | 'profile';
  alternates: Alternates;
  noindex?: boolean;
  /** One or more JSON-LD objects. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { lang, title, description, image, imageWidth = 1200, imageHeight = 630, imageAlt, type = 'website', alternates, noindex = false, jsonLd } = Astro.props;
const { t } = useT(lang);
const { t: tOther } = useT(otherLang(lang));

const fullTitle = title ? `${title} | ${site.name}` : t('meta.siteTitle');
const abs = (p: string) => new URL(p, site.url).href;
const canonical = abs(alternates[lang]);
const ogImage = abs(image ?? site.ogImage);

// Build-time checks so a missing or overlong description is caught before launch.
if (import.meta.env.SSR && !noindex) {
  const where = alternates[lang];
  if (!description?.trim()) console.warn(`[seo] ${where}: missing meta description`);
  else if (description.length > 160) console.warn(`[seo] ${where}: description is ${description.length} characters (aim for ≤ 160)`);
}

const ld = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
{
  noindex ? (
    <meta name="robots" content="noindex" />
  ) : (
    <>
      <link rel="canonical" href={canonical} />
      <link rel="alternate" hreflang="fr" href={abs(alternates.fr)} />
      <link rel="alternate" hreflang="en" href={abs(alternates.en)} />
      <link rel="alternate" hreflang="x-default" href={abs(alternates.fr)} />
    </>
  )
}

<meta property="og:type" content={type} />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content={String(imageWidth)} />
<meta property="og:image:height" content={String(imageHeight)} />
{imageAlt && <meta property="og:image:alt" content={imageAlt} />}
<meta property="og:locale" content={t('meta.ogLocale')} />
<meta property="og:locale:alternate" content={tOther('meta.ogLocale')} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

{site.googleSiteVerification && <meta name="google-site-verification" content={site.googleSiteVerification} />}

{ld.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}

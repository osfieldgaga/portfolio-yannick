---
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import { useT, type Lang } from '../i18n';
import type { ProjectCardData } from '../lib/projects';

interface Props {
  lang: Lang;
  project: ProjectCardData;
}

const { lang, project: p } = Astro.props;
const { t } = useT(lang);
const multi = p.images.length > 1;
---

<li class="card" data-category={p.category}>
  {
    p.cover ? (
      <button type="button" class="zoom" data-lightbox-open={p.slug} aria-label={t('work.open', { t: p.title })}>
        <div class="notch notch-tl frame">
          <div class="notch-in shot" style={`background:${p.coverBg}`}>
            <Picture
              src={p.cover.src}
              alt={p.cover.alt}
              formats={['avif', 'webp']}
              widths={[320, 480, 640, 960].filter((w) => w <= p.cover!.src.width)}
              sizes="(min-width: 1000px) 400px, (min-width: 640px) 50vw, 100vw"
              loading="lazy"
              style={`object-fit:${p.coverFit};padding:${p.coverPadding}`}
            />
          </div>
          {multi && <span class="count">{t('work.imageCount', { i: 1, n: p.images.length })}</span>}
        </div>
      </button>
    ) : (
      <div class="notch notch-tl notch-soft">
        <div class="notch-in placeholder hatch" role="img" aria-label={p.placeholder ?? p.title}>
          <span class="ph-tag">{t('work.soon')}</span>
          <span class="ph-label">{p.placeholder ?? p.title}</span>
        </div>
      </div>
    )
  }
  <div class="meta">
    <span>{p.num} · {t(`categories.${p.category}`)}</span>
    {p.context && <span>{p.context}</span>}
  </div>
  <h3 class="h-card">{p.title}</h3>
  <p class="summary">{p.summary}</p>
  {
    p.href && (
      <a class="case-link" href={p.href}>
        {t('work.caseLink')}
        <span class="sr-only">: {p.title}</span>
        <Icon name="arrow-right" />
      </a>
    )
  }
</li>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-width: 0;
  }
  .frame {
    position: relative;
  }
  .shot {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .shot :global(img) {
    width: 100%;
    height: 100%;
  }
  .count {
    position: absolute;
    right: 10px;
    bottom: 10px;
    background: var(--bg);
    color: var(--ink);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    padding: 3px 8px;
    font-variant-numeric: tabular-nums;
  }
  .placeholder {
    aspect-ratio: 4 / 3;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-end;
    gap: 4px;
    padding: 16px;
  }
  .ph-tag {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    background: var(--bg);
    padding: 2px 6px;
  }
  .ph-label {
    font-size: 13px;
    color: var(--ink);
    background: var(--bg);
    padding: 2px 6px;
  }
  .meta {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .summary {
    color: var(--muted);
    font-size: 15px;
    line-height: 1.5;
  }
  .case-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 15px;
    font-weight: 700;
    color: var(--link);
    text-decoration: underline;
    text-underline-offset: 4px;
    align-self: flex-start;
    min-height: 32px;
  }
</style>

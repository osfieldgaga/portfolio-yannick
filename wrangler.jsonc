// Cloudflare Workers with Static Assets: serves the built site in ./dist.
// No Worker script ("main" is omitted), so every request is a plain static file.
// Docs: https://developers.cloudflare.com/workers/static-assets/
{
  "name": "yannickbamona",
  "compatibility_date": "2026-10-29",
  "assets": {
    "directory": "./dist",
    // Missing URLs get dist/404.html with a 404 status.
    "not_found_handling": "404-page",
    // Matches trailingSlash: 'always' in astro.config.mjs (/a-propos → /a-propos/).
    "html_handling": "force-trailing-slash"
  }
}
